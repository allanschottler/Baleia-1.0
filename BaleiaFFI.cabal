cabal-version: 3.12
name:     Baleia
version: 1.0

-- executable BaleiaTest
--   main-is:             Test.hs
--   hs-source-dirs:      
--     -- test,
--     src
--   ghc-options:         -O3 -fPIC
--   build-depends:       
--     base,
--     -- HUnit,
--     hspec,
--     syb, 
--     template-haskell,
--     hint,
--     vector,
--     storable-tuple,
--     split,
--     directory,
--     text,
--     array,
--     containers,
--     -- dynamic-loader
--   other-modules:
--     Baleia,
--     Baleia.Math,
--     Baleia.Meta,
--     Baleia.Sample,
--     Baleia.Time,
--     Baleia.Internal,
--     -- Control,
--     MyModule
--   default-language:    Haskell2010

foreign-library Baleia
  type:                
    native-shared
  ghc-options:
    -- -shared
    -fPIC
    -optl-Wl,--exclude-all-symbols
  if os(windows) {
    options: standalone
    mod-def-file: Baleia.def  
  }
  other-extensions:
    TemplateHaskell
  install-includes:    
    Start_stub.h 
  other-modules:
    Baleia,
    Baleia.Math,
    Baleia.Meta,
    Baleia.Sample,
    Baleia.Time,
    Baleia.Internal,
    Start,
    -- Control,
    MyModule
  build-depends:
    base,
    syb, 
    template-haskell,
    hint,
    vector,
    storable-tuple,
    split,
    directory,
    text,
    array,
    containers,
    -- dynamic-loader,
  hs-source-dirs:      
    src
  c-sources:           
    csrc/StartEnd.c
  default-language:    
    Haskell2010
