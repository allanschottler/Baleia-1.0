cabal-version: 3.12
name:     Baleia
version: 1.0

executable BaleiaTest
  main-is:             Test.hs
  hs-source-dirs:      
    -- test,
    src
  ghc-options:         -O2
  build-depends:       
    base,
    -- HUnit,
    syb, 
    template-haskell,
    hint,
    vector,
    storable-tuple,
    split,
    directory,
    text,
    array,
    containers
  other-modules:
    Baleia,
    Baleia.Math,
    Baleia.Meta,
    Baleia.Sample,
    Baleia.Time,
    Baleia.Internal,
    DeriveStorable,
    Control
  default-language:    Haskell2010

foreign-library Baleia
  type:                
    native-shared
  ghc-options:
    -threaded
    -O2
    -fPIC
  if os(windows) {
    options: standalone
    mod-def-file: Baleia.def  
  }
  extra-libraries-static: 
    HSrts
  other-extensions:
    TemplateHaskell
  install-includes:    
    Start_stub.h 
  other-modules:
    Baleia,
    Baleia.Math,
    Baleia.Meta,
    Baleia.Sample,
    Baleia.Time,
    Baleia.Internal,
    DeriveStorable,
    Start,
    Control
  build-depends:
    base,
    syb, 
    template-haskell,
    hint,
    vector,
    storable-tuple,
    split,
    directory,
    text,
    array,
    containers
  hs-source-dirs:      
    src
  c-sources:           
    csrc/StartEnd.c
  default-language:    
    Haskell2010
